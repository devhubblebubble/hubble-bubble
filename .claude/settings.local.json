{
  "permissions": {
    "allow": [
      "WebFetch(domain:api.anthropic.com)",
      "mcp__Claude_in_Chrome__tabs_context_mcp",
      "Bash(curl -s --max-filesize 5000000 \"https://api.anthropic.com/v1/design/h/bekFdDKJ2r2e7SwV9juOvg?open_file=index.html\" -o /tmp/design_file.html)",
      "Read(//tmp/**)",
      "Bash(curl -L -s \"https://api.anthropic.com/v1/design/h/bekFdDKJ2r2e7SwV9juOvg?open_file=index.html\" --max-time 30 -w \"%{http_code}\" -o /tmp/design_partial.html)",
      "Bash(curl -s \"https://api.anthropic.com/v1/design/h/bekFdDKJ2r2e7SwV9juOvg/files/index.html\" --max-time 15 -o /tmp/design_index.html)",
      "Bash(curl -s \"https://api.anthropic.com/v1/design/h/bekFdDKJ2r2e7SwV9juOvg\" --max-time 15 -o /tmp/design_meta.json)",
      "Bash(grep -E \"\\(html|css|color|font|background|padding|margin|flex|grid|#[0-9a-f]{3,6}|rgba|section|nav|header|hero|button|card\\)\")",
      "Read(//private/tmp/**)",
      "Bash(xxd)",
      "Bash(cp /tmp/design_partial.html /tmp/design.gz)",
      "Bash(gunzip -f /tmp/design.gz)",
      "Bash(mkdir -p /tmp/design_extracted)",
      "Bash(tar -xf /tmp/design -C /tmp/design_extracted)",
      "Bash(npx tsc *)",
      "Bash(npm run *)",
      "Bash(echo \"Started PID: $!\")",
      "mcp__Claude_Preview__preview_start",
      "Bash(xargs kill *)"
    ]
  }
}
